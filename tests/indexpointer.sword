// expect: 34
// Indexing and slicing through a pointer reach the pointee: `a[i]` with `a` a
// `*[N]T` or `*[]T` is `(*a)[i]`, not an index into the pointer's own slot.
func bump(mut a *[4]i64, mut s *[]i64) i64 {
    a[1] = a[1] + 5
    s[2] = s[2] + a[1]
    part := a[1..3]
    rest := s[1..]
    return part[0] + i64(part.len) + rest[1] + i64(rest.len)
}

func main() int {
    mut xs := [4]i64{}
    xs[1] = 2
    mut ys := [5]i64{}
    mut view := ys[..]
    r := bump(&xs, &view)
    return int(r + ys[2] + xs[1])
}
