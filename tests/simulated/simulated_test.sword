package simulated

// Bugs the simulator has to find, one of each kind, and tests it has to pass.
// tests/run.sh runs this package under `shield test -sim` and holds it to what
// it reports: which tests fail, that the seed it prints makes the failure happen
// again, that a deadlock is called one, and that a test using the network is
// skipped rather than run on a real socket.

import "std/net"
import "std/testing"
import "std/time"

func bump(counter *atomic[u64]) {
    seen := counter.Load()
    counter.Store(seen + 1)
}

// Read, then write: an update is lost whenever both tasks read before either
// writes, which only some orders do.
func TestLostUpdate(mut t *testing.T) !void {
    mut counter := atomic[u64](0)
    scope {
        spawn bump(&counter)
        spawn bump(&counter)
    }
    t.Equal(counter.Load(), u64(2))
}

func first(a *shared[u64], b *shared[u64]) {
    lock x := a {
        lock y := b {
            *y += *x
        }
    }
}

func second(a *shared[u64], b *shared[u64]) {
    lock y := b {
        lock x := a {
            *x += *y
        }
    }
}

// Two locks in opposite orders: each task can end up holding what the other
// wants.
func TestOppositeLocks(mut t *testing.T) !void {
    mut a := shared[u64](1)
    mut b := shared[u64](1)
    scope {
        spawn first(&a, &b)
        spawn second(&a, &b)
    }
}

func add(counter *atomic[u64]) {
    counter.Add(1)
}

// The same work done right passes under every seed.
func TestAtomicAdd(mut t *testing.T) !void {
    mut counter := atomic[u64](0)
    scope {
        for i in 0..4 {
            spawn add(&counter)
        }
    }
    t.Equal(counter.Load(), u64(4))
}

// An hour of sleep costs nothing: the clock moves only when every task waits
// on it, and then straight to the next deadline.
func TestHourLongSleep(mut t *testing.T) !void {
    start := time.Now()
    time.Sleep(time.Seconds(3600))
    try t.Require(time.Since(start).AsSeconds() >= 3600.0)
}

func TestNetwork(mut t *testing.T) !void {
    mut l := try net.Listen(0)
    l.Close()
}
