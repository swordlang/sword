// expect-error: 'buf' is passed to 'pair' as both 'sh' and 'a', which must be different memory
// A function whose tasks reach a shared value and a slice cannot be given a
// shared value holding that slice.

struct Box {
    xs []i64
}

func fill(mut a []i64, t i64) {
    for k in 0..a.len {
        a[k] = a[k] * 10 + t
    }
}

func look(a []i64, mut out *i64) {
    *out = a[0]
}

func locked(sh *shared[Box], t i64) {
    lock b := sh {
        fill(b.xs, t)
    }
}

func put(sh *shared[Box], mut a []i64) {
    lock b := sh {
        b.xs = a
    }
}

func pair(sh *shared[Box], mut a []i64) {
    scope {
        spawn locked(sh, 1)
        spawn fill(a, 2)
    }
}
func main() int {
    mut buf := [4]i64{}
    mut sh := shared[Box](Box{xs: buf[..]})
    pair(&sh, buf[..])
    return int(buf[0])
}
