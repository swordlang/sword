// expect-error: 'xs' is passed to 'work' as both 'a' and 'b', which must be different memory
// Tasks writing pieces of a while every task reads all of b: one slice given
// as both, and a task reads what another is writing.

func reversed(mut dst []i64, src []i64) {
    for i in 0..dst.len {
        dst[i] = src[src.len - 1 - i]
    }
}

func work(mut a []i64, b []i64) {
    scope {
        for part in a.chunks(2) {
            spawn reversed(part, b)
        }
    }
}

func main() int {
    mut xs := [8]i64{1, 2, 3, 4, 5, 6, 7, 8}
    work(xs[..], xs[..])
    return xs[0]
}
