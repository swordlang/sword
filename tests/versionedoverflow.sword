// expect: 134
// expect-panic: panic: integer overflow at line 10
// Every index is in range, so the loop runs without bounds checks and settles
// its overflow at the end; the overflow it finds is still named by its line.

func total(xs []u64, ys []u8) u8 {
    mut acc u8 = 0
    for j in 0..xs.len {
        v := ys[j]
        acc += v
    }
    return acc
}

func main() int {
    a := [4]u64{1, 2, 3, 4}
    b := [5]u8{100, 100, 100, 1, 1}
    return int(total(a[..], b[..]))
}
