// expect: 42
// `else` may start the line after the `}` it follows, in every form of `if`.

func pick(n int, maybe ?int) int {
    if n > 10 {
        return 1
    }
    else if n > 5 {
        return 2
    }
    // a comment between them changes nothing
    else {
        if v := maybe {
            return v
        }
        else {
            return 3
        }
    }
}

func main() int {
    mut total := 0
    total += pick(11, nil)
    total += pick(6, nil)
    total += pick(0, nil)
    total += pick(0, 36)
    mut counter := shared[int](0)
    if lock c := &counter {
        *c += 0
    }

    else {
        total += 100
    }
    return total
}
