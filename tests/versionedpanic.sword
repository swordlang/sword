// expect: 134
// expect-output: turn 2
// expect-panic: panic: index out of bounds at line 15
// The slice indexed is shorter than the one walked, so the test before the
// loop fails and the loop runs as written: the turns before the bad one print,
// and the panic names the same line it always did.

import "std/io"

func walk(xs []u64, ys []u64) !u64 {
    mut acc u64 = 0
    for j in 0..xs.len {
        try io.Printf("turn {}\n", j)
        acc +%= xs[j]
        acc +%= ys[j]
    }
    return acc
}

func main() !int {
    a := [4]u64{1, 2, 3, 4}
    b := [2]u64{5, 6}
    return int(try walk(a[..], b[..]))
}
