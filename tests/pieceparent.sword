// expect-error: this writes 'a', through 'part', while it is already written concurrently
// The parent writes the piece it has just given a task.

func fill(mut xs []i64) {
    for i in 0..xs.len {
        xs[i] += 1
    }
}

func main() int {
    mut a := [8]i64{}
    mut xs := a[..]
    scope {
        for off, part in xs.chunks(4) {
            spawn fill(part)
            part[0] = 5
        }
    }
    return int(a[0])
}
