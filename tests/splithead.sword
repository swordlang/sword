// expect: 134
// expect-panic: panic: integer overflow at line 11
// The first turn takes `k - 1` below zero. It runs as written, before the
// unchecked middle, so the panic is the one it always was.

import "std/io"

func walk(xs []u64) !u64 {
    mut acc u64 = 0
    for k in 0..xs.len {
        acc +%= xs[k - 1]
        try io.Printf("turn {}\n", k)
    }
    return acc
}

func main() !int {
    a := [4]u64{1, 2, 3, 4}
    return int(try walk(a[..]))
}
