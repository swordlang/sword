// expect: 0
// What `shield det` lists for this file is in run.sh: one function of each
// kind, det or not, and the chain under each one that is not.

import "std/mem"
import "std/time"

interface Scale {
    By(v i64) i64
}

struct Twice {
    k i64
}

func (t *Twice) By(v i64) i64 {
    return v * t.k
}

func add(a i64, b i64) i64 {
    return a + b
}

func counted(v i64) i64 {
    mut hits := atomic[u64](0)
    hits.Add(u64(v))
    return i64(hits.Load())
}

func stamped(v i64) i64 {
    return v + time.Now().AsNanos() % 2
}

func later(v i64) i64 {
    return add(stamped(v), 1)
}

func first[T](xs []T) T {
    return xs[0]
}

func never[T](xs []T) u64 {
    return xs.len
}

func scaled(s Scale, v i64) i64 {
    return s.By(v)
}

func grab(mut a mem.Allocator) u64 {
    xs := mem.Alloc[u8](a, 4) orelse return 0
    return xs.len
}

func main() int {
    xs := [3]i64{4, 5, 6}
    t := Twice{k: 2}
    total := add(first[i64](xs[..]), scaled(&t, 1))
    if total + counted(0) + later(0) < 0 {
        return 1
    }
    return 0
}
