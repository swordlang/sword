// expect: 42
// What a parallel for only reads is copied into each piece once. That must not
// change an answer: the same sums through every kind of capture, against loops
// that do the same work in order.

func dot(xs []f64, ys []f64, n int) f64 {
    mut s f64 = 0.0
    parallel for i in 0..n reduce(+: s) {
        s += xs[i] * ys[i]
    }
    return s
}

func dot_walked(xs []f64, ys []f64) f64 {
    mut s f64 = 0.0
    parallel for i in 0..xs.len reduce(+: s) {
        s += xs[i] * ys[i]
    }
    return s
}

struct Box {
    k u64
}

func main() int {
    mut a := [5000]f64{}
    mut b := [5000]f64{}
    for i in 0..5000 {
        a[i] = 1.0 / f64(i + 1)
        b[i] = f64(i % 7) - 3.0
    }
    if dot(a[..], b[..], 5000) != dot_walked(a[..], b[..]) {
        return 1
    }

    // An array is written in place and an atomic is the place: neither may be
    // copied. A string, a pointer and a number are.
    mut arr := [64]u64{}
    mut hits := atomic[u64](0)
    word := "parallel"
    box := Box{k: 3}
    p := &box
    k := u64(2)
    parallel for i in 0..arr.len {
        arr[i] = u64(word[i % word.len]) * k + p.k
        hits.Add(1)
    }
    mut total u64 = 0
    for x in arr {
        total += x
    }
    mut want u64 = 0
    for i in 0..arr.len {
        want += u64(word[i % word.len]) * 2 + 3
    }
    if total != want || hits.Load() != 64 {
        return 2
    }

    // A body that declares, loops and skips, reading a captured string.
    mut letters := [8]u64{}
    mut ls := letters[..]
    parallel for i in 0..ls.len {
        if i == 3 {
            continue
        }
        mut w u64 = 0
        for j in 0..i {
            w += u64(j)
        }
        ls[i] = u64(word[i]) + w
    }
    mut sum u64 = 0
    for x in letters {
        sum += x
    }
    if sum != 801 {
        return 3
    }
    return 42
}
