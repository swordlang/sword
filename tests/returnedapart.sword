// expect-error: 'buf' is passed to 'work' as both 'a' and 'b', which must be different memory
// A function whose tasks need two parameters apart cannot be given a slice
// and something cut from it by another function.

func head(mut a []i64, n u64) []i64 {
    return a[0..n]
}

func fill(mut a []i64, t i64) {
    for k in 0..a.len {
        a[k] = a[k] * 10 + t
    }
}

func work(mut a []i64, mut b []i64) {
    scope {
        spawn fill(a, 1)
        spawn fill(b, 2)
    }
}

func main() int {
    mut buf := [4]i64{}
    work(buf[..], head(buf[..], 2))
    return int(buf[0])
}
