// expect: 0
// expect-output: 1 3 5 7 72
// What a turn may do: copy numbers out of a slice the loop only reads, keep
// a second name for its own piece, and lend the piece to a call that writes
// it. Copying a number out of a slice does not make the piece reach that
// slice.

import "std/io"

func double(mut row []u64) {
    for j in 0..row.len {
        row[j] *= 2
    }
}

func main() !void {
    src := [8]u64{1, 2, 3, 4, 5, 6, 7, 8}
    a := src[..]
    mut backing := [8]u64{}
    mut xs := backing[..]
    parallel for off, part in xs.chunks(2) {
        part[0] = a[off]
        mut same := part
        same[1] = a[off + 1]
        double(part)
    }
    mut out := [4]u64{}
    mut ys := out[..]
    parallel for i in 0..ys.len {
        ys[i] = a[2 * i]
    }
    mut sum u64 = 0
    for x in xs[..] {
        sum += x
    }
    try io.Printf("{} {} {} {} {}\n", ys[0], ys[1], ys[2], ys[3], sum)
}
