// expect: 77
// An error that reaches main becomes the exit status. The standard library's
// 75 errors keep codes 1 to 75 in every program, and a program's own come after
// them in the order they first appear, so Second is 77. A new error in std
// moves this number, and every program's codes with it.


error First  = "the first thing that failed"
error Second = "the second thing that failed"
func first() !void {
    return error.First
}

func second() !void {
    return error.Second
}

func main() !void {
    first() catch {}
    try second()
}
