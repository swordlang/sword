// expect-error: this writes 'buf' while it is already written concurrently
// A slice sent on a channel reaches the task that receives it, which may
// write it, as if it had been handed to that task's spawn.

import "std/mem"

struct Box {
    xs []i64
}

func fill(mut a []i64, t i64) {
    for k in 0..a.len {
        a[k] = a[k] * 10 + t
    }
}

func look(a []i64, mut out *i64) {
    *out = a[0]
}

func received(ch chan[Box], t i64) {
    for mut b := <-ch {
        fill(b.xs, t)
    }
}

func produce(ch chan[Box], mut a []i64) {
    ch <- Box{xs: a} catch {}
    close(ch)
}

func main() !int {
    mut other := [4]i64{}
    mut r := i64(0)
    mut backing := [2048]u8{}
    mut arena := mem.NewArena(backing[..])
    // What travels on a channel comes from an allocator: the frame's own
    // memory would be gone once the frame returns.
    mut buf := mem.Alloc[i64](&arena, 4) orelse return 1
    for k in 0..buf.len {
        buf[k] = 0
    }
    mut ch := try chan[Box](&arena, 2)
    try ch <- Box{xs: buf}
    close(ch)
    scope {
        spawn received(ch, 1)
        spawn fill(buf, 2)
    }
    return int(buf[0] + other[0] + r)
}
