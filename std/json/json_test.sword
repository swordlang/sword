package json

import "std/testing"

const src = "{\"name\":\"ada\",\"age\":36,\"tags\":[\"math\",\"engine\"],\"ok\":true,\"none\":null}"

func TestParseObject(mut t *testing.T) !void {
    mut doc := try Parse([]u8(src), t.Mem)
    root := doc.Root()
    t.Equal(doc.Kind(root), Kind.Object)
    t.Equal(doc.Len(root), 5)

    name := doc.Get(root, "name") orelse return t.Fatalf("no 'name'")
    t.Equal(doc.Kind(name), Kind.Str)
    t.Equal(doc.Text(name), "ada")

    age := doc.Get(root, "age") orelse return t.Fatalf("no 'age'")
    t.Equal(doc.Kind(age), Kind.Number)
    t.Equal(doc.Number(age), 36.0)

    ok := doc.Get(root, "ok") orelse return t.Fatalf("no 'ok'")
    t.Equal(doc.Kind(ok), Kind.Bool)
    t.Equal(doc.Truth(ok), true)

    none := doc.Get(root, "none") orelse return t.Fatalf("no 'none'")
    t.Equal(doc.Kind(none), Kind.Null)

    if missing := doc.Get(root, "nobody") {
        t.Failf("found a key that is not there")
    }
}

func TestParseArray(mut t *testing.T) !void {
    mut doc := try Parse([]u8(src), t.Mem)
    root := doc.Root()
    tags := doc.Get(root, "tags") orelse return t.Fatalf("no 'tags'")
    t.Equal(doc.Kind(tags), Kind.Array)
    t.Equal(doc.Len(tags), 2)

    first := doc.At(tags, 0) orelse return t.Fatalf("no first element")
    t.Equal(doc.Text(first), "math")
    second := doc.At(tags, 1) orelse return t.Fatalf("no second element")
    t.Equal(doc.Text(second), "engine")
    if past := doc.At(tags, 2) {
        t.Failf("found an element past the end")
    }
}

func TestHelpers(mut t *testing.T) !void {
    mut doc := try Parse([]u8(src), t.Mem)
    root := doc.Root()
    t.Equal(doc.GetText(root, "name"), "ada")
    t.Equal(doc.GetText(root, "age"), "")
    t.Equal(doc.GetNumber(root, "age", 0.0), 36.0)
    t.Equal(doc.GetNumber(root, "name", -1.0), -1.0)
}

// An exponent is the document's to choose. One too long to count used to stop
// the program, and one merely large ran a loop for as long as it said; both
// are infinity or zero, the same as a short exponent past a double's range.
func TestHugeExponents(mut t *testing.T) !void {
    text := "[1e99999999999999999999, 1e-99999999999999999999, 1e999999999999, 1e400, 1e-400, 2.5e2]"
    mut doc := try Parse([]u8(text), t.Mem)
    root := doc.Root()
    t.Equal(doc.Len(root), 6)
    want := [6]f64{1.0, 0.0, 1.0, 1.0, 0.0, 250.0}
    for i in 0..6 {
        at := doc.At(root, u64(i)) orelse return t.Fatalf("element {} is missing", i)
        got := doc.Number(at)
        if want[i] == 1.0 {
            // Infinity is the only double larger than the largest finite one.
            t.Equal(got > 1.7976931348623157e308, true)
        } else {
            t.Equal(got, want[i])
        }
    }
}

// Every one of these is malformed somewhere, and none of them may come back
// with a document.
func TestRejectsBadInput(mut t *testing.T) !void {
    bad := [7]string{"", "{", "[1,2", "{\"a\"}", "{\"a\":}", "tru", "{,}"}
    for s in bad {
        try t.RunWith(s, rejects, s)
    }
}

func rejects(mut t *testing.T) !void {
    Parse([]u8(t.Arg.Text), t.Mem) catch {
        return
    }
    t.Failf("parsed it anyway")
}

func TestWriterRoundTrip(mut t *testing.T) !void {
    mut out := try bytes.New(t.Mem, 128)
    mut w := NewWriter(&out)
    w.BeginObject()
    w.Key("name")
    w.Str("grace")
    w.Key("age")
    w.Number(45.0, 0)
    w.EndObject()
    try w.Err()

    mut doc := try Parse([]u8(out.Str()), t.Mem)
    root := doc.Root()
    t.Equal(doc.Kind(root), Kind.Object)
    t.Equal(doc.GetText(root, "name"), "grace")
    t.Equal(doc.GetNumber(root, "age", 0.0), 45.0)
}

// The first thing that goes wrong is kept and everything after it does
// nothing, so a document with a mistake halfway is not half written.
func TestWriterKeepsFirstError(mut t *testing.T) !void {
    mut out := try bytes.New(t.Mem, 64)
    mut w := NewWriter(&out)
    w.BeginArray()
    w.Int(1)
    w.EndArray()
    w.EndArray()
    w.Int(2)
    w.BeginObject()
    t.Equal(out.Str(), "[1]")
    w.Err() catch |e| {
        t.Check(e == error.Unbalanced)
        return
    }
    t.Failf("no error kept")
}

// The nearest double to what the document says, not a sum of digits that
// lands one unit off.
func TestNumbersAreNearest(mut t *testing.T) !void {
    mut doc := try Parse([]u8("[0.3, 1e23, 0.30000000000000004]"), t.Mem)
    root := doc.Root()
    t.Equal(doc.Number(doc.At(root, 0) orelse return t.Fatalf("no 0")), 0.3)
    t.Equal(doc.Number(doc.At(root, 1) orelse return t.Fatalf("no 1")), 1.0e23)
    t.Equal(doc.Number(doc.At(root, 2) orelse return t.Fatalf("no 2")), 0.30000000000000004)
}
