package bytes

import "std/strings"
import "std/testing"

// `t.Mem` is the test's own arena, reset before each test, so nothing here
// frees anything.

func TestInsertAndDelete(mut t *testing.T) !void {
    mut b := try New(t.Mem, 8)
    try b.WriteString("hello world")

    try b.Insert(5, []u8(","))
    t.Equal(b.Str(), "hello, world")

    // At the front and at the end, which are the two ends of the move.
    try b.Insert(0, []u8("> "))
    try b.Insert(b.Len(), []u8("!"))
    t.Equal(b.Str(), "> hello, world!")

    try b.Delete(0, 2)
    t.Equal(b.Str(), "hello, world!")
    try b.Delete(5, 1)
    t.Equal(b.Str(), "hello world!")
    try b.Delete(b.Len() - 1, 1)
    t.Equal(b.Str(), "hello world")
}

// The insert has to grow the buffer and move the tail in the same call, which
// is where an inserting editor spends its life.
func TestInsertGrows(mut t *testing.T) !void {
    mut b := try New(t.Mem, 8)
    for i in 0..200 {
        try b.Insert(0, []u8("ab"))
    }
    t.Equal(b.Len(), 400)
    t.Equal(b.Bytes()[0], 97)
    t.Equal(b.Bytes()[399], 98)
    try t.Require(strings.HasPrefix(b.Str(), "abab"))
}

// A range that is not inside the buffer is an error rather than a clamp, the
// same as everywhere else here.
func TestOutOfRange(mut t *testing.T) !void {
    mut b := try New(t.Mem, 8)
    try b.WriteString("abc")

    b.Insert(4, []u8("x")) catch |e| {
        t.Equal(e, error.OutOfRange)
    }
    b.Delete(2, 2) catch |e| {
        t.Equal(e, error.OutOfRange)
    }
    b.Delete(4, 0) catch |e| {
        t.Equal(e, error.OutOfRange)
    }
    t.Equal(b.Str(), "abc")

    // The far ends of both are inside it: inserting at the length appends, and
    // deleting nothing at the length is nothing.
    try b.Insert(3, []u8("d"))
    try b.Delete(4, 0)
    t.Equal(b.Str(), "abcd")
}

func TestTruncate(mut t *testing.T) !void {
    mut b := try New(t.Mem, 8)
    try b.WriteString("abcdef")

    b.Truncate(3)
    t.Equal(b.Str(), "abc")
    // More than there is leaves it alone: this shortens and nothing else.
    b.Truncate(9)
    t.Equal(b.Str(), "abc")
    b.Truncate(0)
    t.Equal(b.Len(), 0)

    // And it is still a buffer afterwards.
    try b.WriteString("again")
    t.Equal(b.Str(), "again")
}
