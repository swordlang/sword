package strings

import "std/bytes"
import "std/fmt"
import "std/testing"

func bitsOf(v f64) u64 {
    mut x := v
    p := [*]u64(&x)
    return p[0]
}

func parsed(s string) !u64 {
    return bitsOf(try ParseF64(s))
}

// The expected bits are what a correctly rounding parser gives (Python's
// float(), which is one), for text where adding digits up in doubles is not.
func TestParseNearest(mut t *testing.T) !void {
    t.Equal(try parsed("0.3"), u64(0x3FD3333333333333))
    t.Equal(try parsed("0.30000000000000004"), u64(0x3FD3333333333334))
    t.Equal(try parsed("123456789012345678"), u64(0x437B69B4BA630F35))
    t.Equal(try parsed("1e23"), u64(0x44B52D02C7E14AF6))
    t.Equal(try parsed("1.7976931348623157e308"), u64(0x7FEFFFFFFFFFFFFF))
    t.Equal(try parsed("-2.5e-3"), u64(0xBF647AE147AE147B))
}

// Exactly halfway between two doubles goes to the even one; a hair either
// side goes to the nearer. 9007199254740993 is 2^53 + 1, between 2^53 and
// 2^53 + 2.
func TestParseTies(mut t *testing.T) !void {
    t.Equal(try parsed("9007199254740993"), u64(0x4340000000000000))
    t.Equal(try parsed("9007199254740993.0000000000000000001"), u64(0x4340000000000001))
    t.Equal(try parsed("9007199254740995"), u64(0x4340000000000002))
    // Half the smallest subnormal, written out in full, and a hair above it:
    // the tie goes to zero, which is even; the hair above to the subnormal.
    t.Equal(try parsed("2.-324"), u64(1))
    t.Equal(try parsed("2.-324"), u64(0))
    t.Equal(try parsed("2.4703282292062327e-324"), u64(0))
}

func TestParseForms(mut t *testing.T) !void {
    t.Equal(try ParseF64(".5"), 0.5)
    t.Equal(try ParseF64("7."), 7.0)
    t.Equal(try ParseF64("+3.25"), 3.25)
    t.Equal(try ParseF64("00000.000001"), 0.000001)
    t.Equal(try parsed("-0"), u64(0x8000000000000000))
    t.Equal(try parsed("1e400"), u64(0x7FF0000000000000))
    t.Equal(try parsed("1e-400"), u64(0))
}

func TestParseRefuses(mut t *testing.T) !void {
    for s in [7]string{"", "-", ".", "e5", "1e", "1.2.3", " 1"} {
        ParseF64(s) catch |e| {
            t.Equal(e, error.NotANumber)
            continue
        }
        t.Failf("'{}' parsed", s)
    }
}

// A double printed with every digit it has reads back as itself, from the
// largest to the smallest subnormal. Philox would do for the doubles, but a
// small generator here keeps the test to one package.
func TestPrintedReadsBack(mut t *testing.T) !void {
    mut state u64 = 34
    mut b := try bytes.New(t.Mem, 2048)
    for i in 0..300 {
        state = state *% 6364136223846793005 +% 1442695040888963407
        mut bits := state >> 1
        if i % 3 == 0 {
            bits &= 0x000FFFFFFFFFFFFF
        }
        if bits >> 52 == 0x7FF {
            continue
        }
        x := fromBits(bits)
        b.Reset()
        try fmt.F64(&b, x, 1080)
        back := try ParseF64(b.Str())
        if bitsOf(back) != bits {
            t.Failf("{x} printed as {} read back as {x}", bits, b.Str(), bitsOf(back))
        }
    }
}
