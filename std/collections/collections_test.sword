package collections

import "std/mem"
import "std/testing"

// `t.Mem` is the test's own arena, reset before each test, so nothing here
// frees anything.

func TestListGrows(mut t *testing.T) !void {
    mut xs := try NewList[i64](t.Mem, 2)
    t.Equal(xs.Len(), 0)
    t.Equal(xs.Cap(), MinCapacity)

    for i in 0..100 {
        try xs.Push(i64(i) * 2)
    }
    t.Equal(xs.Len(), 100)
    t.Equal(xs.At(0), 0)
    t.Equal(xs.At(99), 198)

    // The window onto the live elements follows the length, not the capacity.
    t.Equal(xs.Slice().len, 100)

    last := xs.Pop() orelse return t.Fatalf("popped nothing")
    t.Equal(last, 198)
    t.Equal(xs.Len(), 99)

    xs.Reset()
    t.Equal(xs.Len(), 0)
    if empty := xs.Pop() {
        t.Failf("popped from an empty list")
    }
}

func TestMapSetAndGet(mut t *testing.T) !void {
    mut m := try NewMap[u64](t.Mem, 8)
    t.Equal(m.Len(), 0)
    if missing := m.Get("nobody") {
        t.Failf("found a key that was never set")
    }

    try m.Set("ada", 1)
    try m.Set("grace", 2)
    try m.Set("alan", 3)
    t.Equal(m.Len(), 3)
    t.Equal(m.Get("ada") orelse 0, 1)
    t.Equal(m.Get("alan") orelse 0, 3)
    t.Equal(m.Has("grace"), true)
    t.Equal(m.Has("edsger"), false)

    // Setting an existing key replaces rather than adds.
    try m.Set("ada", 9)
    t.Equal(m.Len(), 3)
    t.Equal(m.Get("ada") orelse 0, 9)

    t.Equal(m.Delete("grace"), true)
    t.Equal(m.Delete("grace"), false)
    t.Equal(m.Len(), 2)
    if gone := m.Get("grace") {
        t.Failf("found a deleted key")
    }
}

// Past the load factor the table has to rehash, and everything in it has to
// survive that.
func TestMapRehashes(mut t *testing.T) !void {
    mut m := try NewMap[u64](t.Mem, 8)
    mut keys := [64]string{}
    for i in 0..64 {
        keys[i] = try label(t, u64(i))
        try m.Set(keys[i], u64(i))
    }
    t.Equal(m.Len(), 64)
    try t.Require(m.Slots() > 64)

    for i, key in keys {
        t.Equal(m.Get(key) orelse 999, u64(i))
    }
}

// `k0`, `k1`, ... out of the test's own memory. Digits come out backwards,
// which does not matter: the keys only have to differ.
func label(mut t *testing.T, i u64) !string {
    mut room := mem.Alloc[u8](t.Mem, 8) orelse return error.OutOfMemory
    room[0] = 107 // 'k'
    mut n := i
    mut at u64 = 1
    if n == 0 {
        room[at] = 48
        at += 1
    }
    for n > 0 {
        room[at] = 48 + u8(n % 10)
        n = n / 10
        at += 1
    }
    return string(room[0..at])
}

func lessU64(a u64, b u64) bool {
    return a < b
}

func lessText(a string, b string) bool {
    mut i u64 = 0
    for i < a.len && i < b.len {
        if a[i] != b[i] {
            return a[i] < b[i]
        }
        i += 1
    }
    return a.len < b.len
}

// A run long enough to go through every part of the sort: quicksort at the
// top, insertion sort at the bottom, and the pivot choice in between.
func TestSortAndSearch(mut t *testing.T) !void {
    mut xs := [400]u64{}
    mut seed u64 = 12345
    for i in 0..xs.len {
        seed = seed *% 6364136223846793005 +% 1442695040888963407
        xs[i] = seed >> 33
    }
    Sort[u64](xs[..], lessU64)

    for i in 1..xs.len {
        try t.Require(xs[i - 1] <= xs[i])
    }
    // Every element is findable, and the answer is the element itself.
    for i in 0..xs.len {
        at := BinarySearch[u64](xs[..], xs[i], lessU64) orelse
            return t.Fatalf("lost an element the sort kept")
        t.Equal(xs[at], xs[i])
    }
    // A value between two of them is not there. The generator is 31 bits wide,
    // so nothing can equal this.
    if found := BinarySearch[u64](xs[..], 1 << 62, lessU64) {
        t.Failf("found a value that is not in the slice")
    }
}

// The shapes that break a careless sort: nothing, one, two, all the same, and
// a slice that is already in order or exactly against it.
func TestSortEdges(mut t *testing.T) !void {
    mut none := [1]u64{7}
    Sort[u64](none[0..0], lessU64)
    Sort[u64](none[..], lessU64)
    t.Equal(none[0], 7)

    mut two := [2]u64{2, 1}
    Sort[u64](two[..], lessU64)
    t.Equal(two[0], 1)
    t.Equal(two[1], 2)

    mut same := [40]u64{}
    for i in 0..same.len {
        same[i] = 5
    }
    Sort[u64](same[..], lessU64)
    t.Equal(same[0], 5)
    t.Equal(same[39], 5)

    mut down := [64]u64{}
    for i in 0..down.len {
        down[i] = u64(down.len - i)
    }
    Sort[u64](down[..], lessU64)
    for i in 1..down.len {
        try t.Require(down[i - 1] <= down[i])
    }
    Sort[u64](down[..], lessU64) // already sorted, which is the other extreme
    t.Equal(down[0], 1)
    t.Equal(down[63], 64)
}

// The fallback the budget exists for. Reached by hand here: what makes
// quicksort go quadratic depends on the pivot rule, and a test that has to
// guess at one proves nothing.
func TestHeapSortPath(mut t *testing.T) !void {
    mut xs := [50]u64{}
    for i in 0..xs.len {
        xs[i] = u64((i * 37) % 50)
    }
    sortRange[u64](xs[..], lessU64, 0)
    for i in 0..xs.len {
        t.Equal(xs[i], u64(i))
    }
}

func TestSortStrings(mut t *testing.T) !void {
    mut names := [5]string{"grace", "ada", "alan", "edsger", "ada"}
    Sort[string](names[..], lessText)
    t.Equal(names[0], "ada")
    t.Equal(names[1], "ada")
    t.Equal(names[2], "alan")
    t.Equal(names[4], "grace")

    at := BinarySearch[string](names[..], "edsger", lessText) orelse
        return t.Fatalf("a name that is there was not found")
    t.Equal(names[at], "edsger")
}

// A key that is not a string: the table from a key code to what it does is the
// case that asked for this.
func TestMapOfNumbers(mut t *testing.T) !void {
    mut binds := try NewMapOf[u8, u64](t.Mem, 8)
    try binds.Set(3, 30)
    try binds.Set(4, 40)
    t.Equal(binds.Len(), 2)
    t.Equal(binds.Get(3) orelse 0, 30)
    t.Equal(binds.Has(9), false)

    // Enough to rehash several times, with every key still findable after.
    mut wide := try NewMapOf[i64, i64](t.Mem, 4)
    for i in 0..300 {
        try wide.Set(i64(i) * 7, i64(i))
    }
    t.Equal(wide.Len(), 300)
    for i in 0..300 {
        t.Equal(wide.Get(i64(i) * 7) orelse -1, i64(i))
    }
    t.Equal(wide.Delete(7), true)
    t.Equal(wide.Delete(7), false)
}

func TestMapOfEnum(mut t *testing.T) !void {
    mut what := try NewMapOf[Key, string](t.Mem, 4)
    try what.Set(Key.Up, "up")
    try what.Set(Key.Down, "down")
    t.Equal(what.Get(Key.Up) orelse "", "up")
    t.Equal(what.Get(Key.Left) orelse "nothing", "nothing")
}

enum Key i32 {
    Up = 1
    Down = 2
    Left = 3
}

func BenchmarkSortShuffled(mut b *testing.B) !void {
    mut xs := mem.Alloc[u64](b.Mem, 1024) orelse return error.OutOfMemory
    mut seed u64 = 7
    b.ResetTimer()
    for run in 0..b.N {
        b.StopTimer()
        for i in 0..xs.len {
            seed = seed *% 6364136223846793005 +% 1442695040888963407
            xs[i] = seed >> 33
        }
        b.StartTimer()
        Sort[u64](xs, lessU64)
        b.Keep(i64(xs[0]))
    }
}

func BenchmarkMapSet(mut b *testing.B) !void {
    mut m := try NewMapOf[u64, u64](b.Mem, 1024)
    b.ResetTimer()
    for i in 0..b.N {
        try m.Set(u64(i) % 512, u64(i))
    }
}
