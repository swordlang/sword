// The doubles nearest k·pi/2, where reducing the argument cancels the most and
// the second and third pieces of pi/2 are needed, and both sides of 2^19·pi/2,
// where the reduction changes method. Within half a unit in the last place.
func TestSinCosNearMultiplesOfHalfPi(mut t *testing.T) !void {
    sines := [16]vector{
        vector{x: 4609753056924675352, y: 4607182418800017408},
        vector{x: 4614256656552045848, y: 4368955796522032135},
        vector{x: 4616991696741409234, y: 13830554455654793216},
        vector{x: 4622379576087783285, y: 13830554455654793216},
        vector{x: 4654623250751067146, y: 4409802208948657697},
        vector{x: 4666735955038386880, y: 4607182418800017408},
        vector{x: 4681810650962603288, y: 13659881827787365383},
        vector{x: 4691839462074104460, y: 4607182418800017408},
        vector{x: 4695321436351677072, y: 13830554455654793216},
        vector{x: 4695321449844714776, y: 13673392626669476871},
        vector{x: 4699825048058331136, y: 13822866869463883422},
        vector{x: 4699825048058331135, y: 13822866869467852544},
        vector{x: 4699825048058331137, y: 13822866869459914300},
        vector{x: 4699825052353298432, y: 4603774455231559403},
        vector{x: 13877995287605842954, y: 13633174245803433505},
        vector{x: 13918693473206452880, y: 4607182418800017408},
    }
    cosines := [16]vector{
        vector{x: 4609753056924675352, y: 4364452196894661639},
        vector{x: 4614256656552045848, y: 13830554455654793216},
        vector{x: 4616991696741409234, y: 13594811712176818698},
        vector{x: 4622379576087783285, y: 13600557251204194572},
        vector{x: 4654623250751067146, y: 4607182418800017408},
        vector{x: 4666735955038386880, y: 4420387102973437853},
        vector{x: 4681810650962603288, y: 4607182418800017408},
        vector{x: 4691839462074104460, y: 4448100819925877110},
        vector{x: 4695321436351677072, y: 4449421432486679735},
        vector{x: 4695321449844714776, y: 4607182418800017408},
        vector{x: 4699825048058331136, y: 4606698844765971162},
        vector{x: 4699825048058331135, y: 4606698844765293251},
        vector{x: 4699825048058331137, y: 4606698844766649073},
        vector{x: 4699825052353298432, y: 4605230586165379284},
        vector{x: 13877995287605842954, y: 4607182418800017408},
        vector{x: 13918693473206452880, y: 4449421432486679735},
    }
    try checkBits(t, "Sin", Sin, sines[..])
    try checkBits(t, "Cos", Cos, cosines[..])
}

func TestSpecialValues(mut t *testing.T) !void {
    try t.Require(IsNaN(Sqrt(-1.0)))
    t.Equal(Sqrt(0.0), 0.0)
    t.Equal(Sqrt(Inf()), Inf())
    t.Equal(Sqrt(4.0), 2.0)
    t.Equal(Log(0.0), -Inf())
    try t.Require(IsNaN(Log(-1.0)))
    t.Equal(Log(1.0), 0.0)
    t.Equal(Log(Inf()), Inf())
    t.Equal(Exp(0.0), 1.0)
    t.Equal(Exp(Inf()), Inf())
    t.Equal(Exp(-Inf()), 0.0)
    t.Equal(Exp(1000.0), Inf())
    t.Equal(Exp(-1000.0), 0.0)
    try t.Require(IsNaN(Exp(NaN())))
    t.Equal(Sin(0.0), 0.0)
    t.Equal(Cos(0.0), 1.0)
    try t.Require(IsNaN(Sin(Inf())))
    try t.Require(IsNaN(Cos(-Inf())))
    try t.Require(IsNaN(Sin(NaN())))
}
