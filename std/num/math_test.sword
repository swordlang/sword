package num

import "std/testing"

// Exact bits, not a tolerance. Every expected value was checked against a
// sixty-digit reference and is within one unit in the last place of the true
// value; what these tests add is that the answer is the same bits on every
// machine that runs them, which is the reason the functions exist.

struct vector {
    x u64
    y u64
}

func checkBits(mut t *testing.T, name string, f func(f64) f64,
               cases []vector) !void {
    for c in cases {
        got := bitsOf(f(fromBits(c.x)))
        if got != c.y {
            t.Failf("{}({}): got bits {} want {}", name, fromBits(c.x), got, c.y)
        }
    }
}

