package testing

import "std/bytes"
import "std/collections"
import "std/fmt"
import "std/io"
import "std/mem"
import "std/os"
import "std/strings"
import "std/time"

// Private: the framework raises these and catches them itself. A test that
// wants to fail calls t.Fail, not this.
error failed  = "the test failed"
error skipped = "the test was skipped"
error TooDeep = "nested deeper than the limit allows"

// Memory each test gets. Tests run at the same time by default, so this is per
// task rather than shared, and a test that needs more builds its own arena.
const ArenaSize = 262144
// How many tests may run at once. Sword has no global state, so two tests
// cannot reach each other except through a port, a file or the clock — the
// reason other languages default to running them in order simply is not here.
const DefaultParallel = 64
// How deep `Run` may nest. Deeper than this and the label stops being a label.
const MaxDepth = 4

// What `shield test` hands the runner: a name and the function to call. Written
// out by the compiler, one per `Test*` function it found.
struct Case {
    Name string
    Run  func(mut *T) !void
}

// A function type carries types and not names, so the field above reads
// `func(mut *T) !void`: a test takes one test, and may fail.
//
// A package-qualified struct literal is not a thing yet either, so the generated
// main says `testing.NewCase(...)` rather than building a Case by hand.
func NewCase(name string, run func(mut *T) !void) Case {
    return Case{Name: name, Run: run}
}

// Everything one test needs. It is handed in rather than reached for, which is
// what lets the runner reset the memory and collect the result.
struct T {
    // The test's own memory. Each test has its own, so a test never frees.
    Mem mem.Allocator
    // What `RunWith` was given. There are no closures, so this is how a subtest
    // is told which case it is: read `Arg.Text` or `Arg.Int`. It carries
    // nothing unless RunWith put something there.
    Arg any

    name   string
    subs   [MaxDepth]string
    depth  u64
    failed bool
    // Everything this test said, kept until it finishes. Tests run together, so
    // writing straight to the terminal would interleave them line by line.
    out bytes.Buffer
    // Something it said did not fit in its memory. Saying is not allowed to
    // fail — a check that cannot report is still a check — so the runner owns
    // up to it once, at the end.
    cut bool
}

func nothing() any {
    return any{Kind: 0, Int: 0, Real: 0.0, Text: ""}
}

func newT(name string, mut a mem.Allocator) !T {
    return T{Mem: a, Arg: nothing(), name: name, subs: [MaxDepth]string{},
             depth: 0, failed: false, out: try bytes.New(a, 512), cut: false}
}

func (t *T) Name() string {
    return t.name
}

func (t *T) Failed() bool {
    return t.failed
}

func (mut t *T) say(s string) {
    t.out.WriteString(s) catch {
        t.cut = true
    }
}

func (mut t *T) sayf(format string, args []any) {
    fmt.Format(&t.out, format, args) catch {
        t.cut = true
    }
}

// `--- FAIL  TestName/sub`, written once per message. Repeating it is what keeps
// a run readable when several things go wrong in one test.
func (mut t *T) header() {
    t.failed = true
    t.say("--- FAIL  ")
    t.say(t.name)
    for i in 0..t.depth {
        t.say("/")
        t.say(t.subs[i])
    }
    t.say("\n")
}

// Marks the test failed and says nothing. Use it where the reason is already on
// screen.
func (mut t *T) Fail() {
    t.header()
}

func (mut t *T) Failf(format string, args ...any) {
    t.header()
    t.say("      ")
    t.sayf(format, args)
    t.say("\n")
}

// Same, and ends the test: the error travels out through the `try` at the call
// site, which is the only way to leave a function early here.
func (mut t *T) Fatalf(format string, args ...any) !void {
    t.Failf(format, args...)
    return error.failed
}

func (mut t *T) Logf(format string, args ...any) {
    t.say("      ")
    t.sayf(format, args)
    t.say("\n")
}

func (mut t *T) Check(ok bool) {
    if !ok {
        t.Failf("check failed")
    }
}

func (mut t *T) Require(ok bool) !void {
    if !ok {
        try t.Fatalf("requirement failed")
    }
}

// Two values are the same when they carry the same thing. An integer and an
// unsigned integer compare by value, because `5` and `u64(5)` are the same
// number however they were written.
func alike(a any, b any) bool {
    counted := a.Kind == fmt.KindInt || a.Kind == fmt.KindUint
    if counted && (b.Kind == fmt.KindInt || b.Kind == fmt.KindUint) {
        return a.Int == b.Int
    }
    if a.Kind != b.Kind {
        return false
    }
    switch a.Kind {
    case fmt.KindBool, fmt.KindPointer:
        return a.Int == b.Int
    case fmt.KindFloat:
        return a.Real == b.Real
    case fmt.KindString:
        return a.Text == b.Text
    default:
        return true // two of nothing
    }
}

// Strings are quoted so that trailing space and tabs are visible, which is
// exactly what one of these failures is usually about.
func (mut t *T) show(label string, v any) {
    t.say(label)
    if v.Kind == fmt.KindString {
        fmt.Quote(&t.out, v.Text) catch {
            t.cut = true
        }
    } else {
        fmt.Value(&t.out, v) catch {
            t.cut = true
        }
    }
}

func (mut t *T) mismatch(got any, want any) {
    t.header()
    t.say("      ")
    t.show("got ", got)
    t.show(", want ", want)
    t.say("\n")
}

// Records a mismatch and carries on, so one run reports everything that is
// wrong rather than the first thing.
func (mut t *T) Equal(got any, want any) {
    if !alike(got, want) {
        t.mismatch(got, want)
    }
}

// Equal by another name, which tests written before both carried on still use.
func (mut t *T) Same(got any, want any) {
    t.Equal(got, want)
}

// Records a mismatch and ends the test, for a value the rest of it cannot go
// on without: a length that is about to be indexed, a pointer about to be
// followed.
func (mut t *T) Must(got any, want any) !void {
    if !alike(got, want) {
        t.mismatch(got, want)
        return error.failed
    }
}

// Ends the test without failing it. The reason is printed, because a silently
// skipped test is one nobody ever comes back to.
func (mut t *T) Skip(why string) !void {
    t.say("--- SKIP  ")
    t.say(t.name)
    t.say(": ")
    t.say(why)
    t.say("\n")
    return error.skipped
}

// A test within a test, which is what gives a section of one its own label. A
// subtest that fails fails the test around it, and one that ends early does not
// end that one.
func (mut t *T) Run(name string, body func(mut *T) !void) !void {
    try t.RunWith(name, body, nothing())
}

// The same, with one value handed to the body through `t.Arg`. A subtest body is
// a plain function and there are no closures, so this is the only way it can be
// told which case it is. For a case with more than one value in it, loop over
// the table in the test itself and name the case in the message.
func (mut t *T) RunWith(name string, body func(mut *T) !void, arg any) !void {
    if t.depth >= MaxDepth {
        return error.TooDeep
    }
    t.subs[t.depth] = name
    t.depth += 1
    outer := t.Arg
    t.Arg = arg

    body(t) catch |e| {
        if e != error.failed && e != error.skipped {
            t.Failf("returned error.{}", nameof(e))
        }
    }

    t.Arg = outer
    t.depth -= 1
}

// The shared tally, so every task can add to it and the run can be reported
// once at the end.
struct Tally {
    failed  atomic[u64]
    skipped atomic[u64]
}

// One test, on its own task with its own memory, saying nothing to the terminal
// until it is done.
func runOne(cases []Case, at u64, tally *Tally, gate *shared[u64]) !void {
    mut backing := [ArenaSize]u8{}
    mut arena := mem.NewArena(backing[..])
    // A test is exactly where a use-after-reset should be loud: anything still
    // holding memory from before a `t.Mem` reset reads 0xDE rather than the next
    // allocation's data. It costs a write per byte and a test has few.
    arena.Watch = true

    c := cases[at]
    mut t := try newT(c.Name, &arena)
    mut was_skipped := false
    c.Run(&t) catch |e| {
        if e == error.skipped {
            was_skipped = true
        } else if e != error.failed {
            t.Failf("returned error.{}", nameof(e))
        }
    }

    if t.failed {
        tally.failed.Add(1)
    } else if was_skipped {
        tally.skipped.Add(1)
    }

    // The whole of what this test said, in one piece. Without the lock two
    // tests finishing together would shuffle their lines into each other.
    if t.out.Len() > 0 || t.cut {
        lock held := gate {
            try io.Write(io.Stdout, string(t.out.Bytes()))
            if t.cut {
                try io.Write(io.Stdout, "      (more was said than fit in the test's memory)\n")
            }
        }
    }
}

// `-p N` caps how many run at once; `-p 1` puts them back in order, which is
// what a test needing a port or a directory to itself wants.
func parallelism() u64 {
    mut room := [16]string{}
    args := os.Args(room[..])
    for i in 0..args.len {
        if args[i] != "-p" || i + 1 >= args.len {
            continue
        }
        want := strings.ParseU64(args[i+1]) catch 0
        if want > 0 {
            return want
        }
    }
    return DefaultParallel
}

// `-only NAME` keeps just that test, chosen when the binary runs rather than
// when it is built: `shield test -sim` runs each test on its own under many
// seeds, and building once is what makes that affordable. Empty when not given.
func onlyName() string {
    mut room := [16]string{}
    args := os.Args(room[..])
    for i in 0..args.len {
        if args[i] == "-only" && i + 1 < args.len {
            return args[i+1]
        }
    }
    return ""
}

func listing() bool {
    mut room := [16]string{}
    args := os.Args(room[..])
    for i in 0..args.len {
        if args[i] == "-list" {
            return true
        }
    }
    return false
}

// Runs every case and reports. The exit status is what `shield test` hands back
// to the shell: zero only when nothing failed.
func Run(cases []Case) !int {
    // `-list` names the tests, one a line, and runs none.
    if listing() {
        mut w := io.NewWriter(io.Stdout)
        for c in cases {
            try w.WriteString(c.Name)
            try w.WriteString("\n")
        }
        try w.Flush()
        return 0
    }
    only := onlyName()
    mut tally := Tally{failed: atomic[u64](0), skipped: atomic[u64](0)}
    mut gate := shared[u64](0)
    at_once := parallelism()
    start := time.Now()

    // A scope per batch rather than one for everything: it is the join that
    // bounds how many tasks — and how many stacks — exist at a time.
    mut from u64 = 0
    for from < cases.len {
        mut upto := from + at_once
        if upto > cases.len {
            upto = cases.len
        }
        scope {
            for i in from..upto {
                if only.len == 0 || cases[i].Name == only {
                    spawn runOne(cases, i, &tally, &gate)
                }
            }
        }
        from = upto
    }

    took := time.Since(start)
    failed := tally.failed.Load()
    skipped := tally.skipped.Load()
    // `-only` is how the simulator runs one test a seed, and it writes its own
    // summary; a tally of one here would sit in the middle of its report.
    if only.len > 0 {
        if failed > 0 {
            return 1
        }
        return 0
    }

    mut w := io.NewWriter(io.Stdout)
    if failed == 0 {
        try w.WriteString("ok    ")
    } else {
        try w.WriteString("FAIL  ")
    }
    try fmt.U64(&w, cases.len)
    try w.WriteString(" tests")
    if failed > 0 {
        try w.WriteString(", ")
        try fmt.U64(&w, failed)
        try w.WriteString(" failed")
    }
    if skipped > 0 {
        try w.WriteString(", ")
        try fmt.U64(&w, skipped)
        try w.WriteString(" skipped")
    }
    try w.WriteString("  (")
    try fmt.U64(&w, u64(took.AsMillis()))
    try w.WriteString("ms)\n")
    try w.Flush()

    if failed > 0 {
        return 1
    }
    return 0
}

// --- benchmarks ------------------------------------------------------------

// How long one measurement should last before the number it gives means
// anything. Short enough that a suite of them is still something you run.
const benchTarget = 100000000 // nanoseconds
// Odd, so that the median is one of the samples rather than a number between
// two of them.
const benchSamples = 9
const benchMaxN = 1 << 30

// What `shield test -bench` runs, one per `Benchmark*` function the compiler
// found.
struct Bench {
    Name string
    Run  func(mut *B) !void
}

func NewBench(name string, run func(mut *B) !void) Bench {
    return Bench{Name: name, Run: run}
}

// What a benchmark is handed. The body does its work `N` times:
//
//     func BenchmarkSum(mut b *testing.B) !void {
//         mut xs := try mem.Alloc[i64](b.Mem, 1024) orelse ...
//         b.ResetTimer()
//         for i in 0..b.N {
//             b.Keep(total(xs))
//         }
//     }
//
// The harness picks `N`: it runs the body with a small one, sees how long that
// took, and scales until a measurement lasts long enough to be worth reading.
struct B {
    // The benchmark's own memory, reset before every sample. How much of it the
    // body used is reported per operation — a number that needs no guessing
    // here, because nothing allocates without being handed an allocator.
    Mem mem.Allocator
    // How many times to do the work. Read it, do not write it.
    N u64

    name    string
    started time.Instant
    elapsed i64 // nanoseconds, while the clock was running
    running bool
    kept    i64 // where Keep puts what nothing else reads
    // The arena behind `Mem`, and how much of it was gone when the clock was
    // last reset: what the body allocates setting itself up is not what it
    // allocates per operation.
    arena *mem.Arena
    base  u64
}

func (b *B) Name() string {
    return b.name
}

// Stops the clock for setup or checking in the middle of a body, and starts it
// again. What happens in between is not counted.
func (mut b *B) StopTimer() {
    if b.running {
        b.elapsed += time.Since(b.started).AsNanos()
        b.running = false
    }
}

func (mut b *B) StartTimer() {
    if !b.running {
        b.started = time.Now()
        b.running = true
    }
}

// Throws away what has been timed so far, for a body whose setup is expensive
// enough to drown the thing being measured.
func (mut b *B) ResetTimer() {
    b.elapsed = 0
    b.base = b.arena.Used()
    b.started = time.Now()
    b.running = true
}

// Where a result that nothing else reads goes, so the work is not thrown away
// for having no effect. The wrapping add is deliberate: this must never be the
// thing that stops a benchmark.
func (mut b *B) Keep(v i64) {
    b.kept +%= v
}

func (mut b *B) KeepFloat(v f64) {
    if v != 0.0 {
        b.kept +%= 1
    }
}

// What one benchmark ended up measuring.
struct Result {
    Name   string
    N      u64
    Median i64 // nanoseconds for the whole run of N
    // The quartiles rather than the ends: one sample that landed on another
    // program's scheduling says nothing about the measurement, and the range
    // is exactly the statistic it moves furthest.
    Low     i64
    High    i64
    Fastest i64
    Slowest i64
    Bytes   u64 // what the body allocated, over all N
}

func (r Result) PerOp() f64 {
    if r.N == 0 {
        return 0.0
    }
    return f64(r.Median) / f64(r.N)
}

// Half the distance between the quartiles, as a share of the middle sample.
// A number this cannot be read without: two benchmarks whose medians differ by
// less than their spread have not been told apart.
func (r Result) Spread() f64 {
    if r.Median <= 0 {
        return 0.0
    }
    return f64(r.High - r.Low) * 50.0 / f64(r.Median)
}

func lessNanos(a i64, b i64) bool {
    return a < b
}

// One measurement: the body, N times, on memory nobody else has touched. What
// it answers is how long it took and how much it allocated after the clock was
// last reset.
struct Measure {
    Nanos i64
    Bytes u64
}

func sample(c Bench, mut arena *mem.Arena, n u64) !Measure {
    arena.Reset()
    mut b := B{Mem: arena, N: n, name: c.Name, started: time.Now(),
               elapsed: 0, running: true, kept: 0, arena: arena, base: 0}
    b.started = time.Now()
    try c.Run(&b)
    b.StopTimer()
    mut took := b.elapsed
    if took < 0 {
        took = 0
    }
    mut used := arena.Used()
    if used < b.base {
        used = b.base
    }
    return Measure{Nanos: took, Bytes: used - b.base}
}

// Finds an N whose measurement lasts long enough to mean something, then takes
// several of them and reports the middle one. The middle rather than the
// average: one sample that landed on another program's scheduling should not
// move the answer.
func runBench(c Bench, mut arena *mem.Arena) !Result {
    mut n u64 = 1
    for {
        took := (try sample(c, arena, n)).Nanos
        if took >= benchTarget || n >= benchMaxN {
            break
        }
        // Scale towards the target, doubling at the least so that a body too
        // fast to time still converges, and by no more than a hundredfold so
        // that one lucky measurement cannot ask for an hour of work.
        mut next := n * 2
        if took > 0 {
            want := n * u64(benchTarget / took)
            if want > next {
                next = want
            }
        }
        if next > n * 100 {
            next = n * 100
        }
        if next > benchMaxN {
            next = benchMaxN
        }
        n = next
    }

    mut times := [benchSamples]i64{}
    mut bytes u64 = 0
    for s in 0..benchSamples {
        one := try sample(c, arena, n)
        times[s] = one.Nanos
        if s == 0 || one.Bytes > bytes {
            bytes = one.Bytes
        }
    }
    collections.Sort[i64](times[..], lessNanos)
    return Result{Name: c.Name, N: n, Median: times[benchSamples / 2],
                  Low: times[benchSamples / 4],
                  High: times[benchSamples - 1 - benchSamples / 4],
                  Fastest: times[0], Slowest: times[benchSamples - 1],
                  Bytes: bytes}
}

// Benchmarks run one at a time and in the order they were written. Two of them
// at once would be measuring each other.
func RunBenches(cases []Bench) !int {
    mut backing := [ArenaSize]u8{}
    mut arena := mem.NewArena(backing[..])
    mut w := io.NewWriter(io.Stdout)
    mut failed u64 = 0
    try w.WriteString("benchmarking: median of 9 samples, spread half the quartile range\n")

    for i in 0..cases.len {
        r := runBench(cases[i], &arena) catch |e| {
            try w.WriteString("--- FAIL  ")
            try w.WriteString(cases[i].Name)
            try w.WriteString(": returned error.")
            try w.WriteString(nameof(e))
            try w.WriteString("\n")
            failed += 1
            continue
        }
        try report(&w, r)
    }

    try w.Flush()
    if failed > 0 {
        return 1
    }
    return 0
}

// One line per benchmark: the middle measurement per operation, how far the
// fastest and slowest were from it, how many times it ran and what it
// allocated while the clock was running.
func report(mut w *io.Writer, r Result) !void {
    try fmt.Pad(w, r.Name, 30)
    try w.WriteString("  ")
    try fmt.F64(w, r.PerOp(), 2)
    try w.WriteString(" ns/op  ")
    try fmt.F64(w, r.Spread(), 1)
    try w.WriteString("%  N=")
    try fmt.U64(w, r.N)
    if r.Bytes > 0 {
        try w.WriteString("  ")
        try fmt.F64(w, f64(r.Bytes) / f64(r.N), 1)
        try w.WriteString(" B/op")
    }
    try w.WriteString("\n")
}
