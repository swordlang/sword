{
  "name": "sword",
  "displayName": "Sword",
  "description": "The Sword language: diagnostics, completion and semantic colouring from swordls, running programs and tests, snippets.",
  "version": "0.1.0",
  "publisher": "tessaro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/swordlang/sword",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/swordlang/sword",
  "bugs": "https://github.com/swordlang/sword/issues",
  "keywords": ["sword", "shield", "swordls", "systems programming", "concurrency"],
  "engines": { "vscode": "^1.91.0" },
  "categories": ["Programming Languages", "Snippets"],
  "activationEvents": ["onLanguage:sword"],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sword",
        "aliases": ["Sword", "sword"],
        "extensions": [".sword"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sword",
        "scopeName": "source.sword",
        "path": "./syntaxes/sword.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sword",
        "path": "./snippets/sword.json"
      }
    ],
    "commands": [
      {
        "command": "sword.runFile",
        "title": "Run File",
        "category": "Sword",
        "icon": "$(play)"
      },
      {
        "command": "sword.runTests",
        "title": "Run Tests in Package",
        "category": "Sword",
        "icon": "$(beaker)"
      },
      {
        "command": "sword.runTest",
        "title": "Run Test",
        "category": "Sword"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "sword.runFile", "when": "editorLangId == sword" },
        { "command": "sword.runTests", "when": "editorLangId == sword" },
        { "command": "sword.runTest", "when": "false" }
      ],
      "editor/title/run": [
        { "command": "sword.runFile", "when": "resourceLangId == sword", "group": "navigation@1" },
        { "command": "sword.runTests", "when": "resourceLangId == sword", "group": "navigation@2" }
      ],
      "editor/context": [
        { "command": "sword.runFile", "when": "resourceLangId == sword", "group": "sword@1" },
        { "command": "sword.runTests", "when": "resourceLangId == sword", "group": "sword@2" }
      ]
    },
    "configurationDefaults": {
      "[sword]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "Sword",
      "properties": {
        "sword.serverPath": {
          "type": "string",
          "default": "swordls",
          "description": "The language server: a name looked up on PATH, or a path."
        },
        "sword.shieldPath": {
          "type": "string",
          "default": "shield",
          "description": "The compiler, used to run programs and tests: a name looked up on PATH, or a path."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build -- --minify",
    "package": "vsce package --no-dependencies",
    "test": "npm run build && node test/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "ovsx": "^1.3.0"
  }
}
